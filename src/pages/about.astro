---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { about, contacts } from '@/config/site';

const { name, desc, avatar } = about;
---

<BaseLayout pageTitle="关于">
<div class="page-wrap">
    <div class="header">
        <div id="page-title">关于我</div>
    </div>

    <div class="main">
        <!-- 顶部：图片正常显示 -->
        <div class="hero">
            <div class="hero-bg" style={`background-image: url('${avatar}')`} aria-hidden="true"></div>
        </div>

        <!-- 中部：介绍卡片 -->
        <div class="intro-card">
            <div class="intro-head">
                <h2 class="intro-name">{name}</h2>
                <div class="contact-icons">
                    {contacts.map((c) => (
                        c.type === 'email' && c.value ? (
                            <a class="contact-icon" href={`mailto:${c.value}`} title={`${c.label}: ${c.value}`}>
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                            </a>
                        ) : c.type === 'github' && c.value ? (
                            <a class="contact-icon" href={c.value} target="_blank" rel="noopener noreferrer" title={c.label}>
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
                            </a>
                        ) : (
                            <button type="button" class="contact-icon" data-copy={c.value || ''} title={c.value ? `${c.label}: ${c.value}（点击复制）` : c.label}>
                                {c.type === 'wechat' && (
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8.69 3C5.33 3 2.5 5.37 2.5 8.42c0 1.72.9 3.25 2.3 4.25l-.58 1.74 2.02-1.01c.62.2 1.29.31 1.99.31.25 0 .5-.02.74-.05a4.9 4.9 0 0 1-.36-1.83c0-3.07 2.78-5.56 6.2-5.56.25 0 .5.01.74.04C15.03 4.4 12.1 3 8.69 3Zm-2.6 3.9a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Zm5.19 0a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z"/><path d="M21.5 13.25c0-2.64-2.46-4.79-5.5-4.79s-5.5 2.15-5.5 4.79 2.46 4.79 5.5 4.79c.61 0 1.2-.09 1.76-.26l1.73.86-.5-1.49c1.19-.9 1.51-2.19 1.51-2.91Zm-4.26-1.03a.78.78 0 1 1 0-1.56.78.78 0 0 1 0 1.56Zm3.52 0a.78.78 0 1 1 0-1.56.78.78 0 0 1 0 1.56Z"/></svg>
                                )}
                                {c.type === 'github' && (
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
                                )}
                            </button>
                        )
                    ))}
                </div>
            </div>
            <p class="intro-desc">{desc}</p>
        </div>
    </div>
</div>
</BaseLayout>

<script>
// 点击微信图标复制微信号
document.querySelectorAll('.contact-icon[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        try {
            await navigator.clipboard.writeText(text);
            btn.setAttribute('data-copied', 'true');
            const original = btn.getAttribute('title') || '';
            btn.setAttribute('title', '已复制 ' + text);
            setTimeout(() => btn.setAttribute('title', original), 1500);
        } catch (e) {
            // 剪贴板不可用时降级为提示
            window.prompt('复制微信号：', text);
        }
    });
});
</script>

<style>
.page-wrap {
    padding: 32px 16px;
}

.header {
    padding-bottom: 15px;
    border-bottom: 1px dotted #ece9e9;
}

.main {
    margin: 20px 0;
}

#page-title {
    font-size: 20px;
    padding: 2px 0;
}

/* ---------- 顶部 hero：图片正常显示 ---------- */
.hero {
    position: relative;
    height: 320px;
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 24px;
}

/* 背景图：正常清晰显示（不再默认模糊），图片路径由 site.ts 配置 */
.hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
}

/* ---------- 中部：介绍卡片（与项目风格一致） ---------- */
.intro-card {
    background: #fff;
    border: 1px solid #ece9e9;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
}

.intro-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    margin: 0 0 14px;
    border-bottom: 1px dotted #ece9e9;
}

.intro-name {
    font-size: 20px;
    font-weight: 700;
    color: #006cac;
    margin: 0;
}

/* 联系方式图标 */
.contact-icons {
    display: flex;
    align-items: center;
    gap: 12px;
}

.contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: #006cac;
    background: #f0f7fb;
    border: 1px solid #dcecf5;
    cursor: pointer;
    padding: 0;
    font: inherit;
    line-height: 1;
    transition: all .2s ease;
}

a.contact-icon:hover,
button.contact-icon:hover {
    color: #fff;
    background: #006cac;
    border-color: #006cac;
    transform: translateY(-2px);
}

button.contact-icon:focus-visible,
a.contact-icon:focus-visible {
    outline: 2px solid #006cac;
    outline-offset: 2px;
}

.intro-desc {
    font-size: 15px;
    line-height: 1.9;
    color: #444;
    margin: 0;
    word-break: break-word;
}

/* ---------- 响应式 ---------- */
@media (max-width: 640px) {
    .hero {
        height: 260px;
    }

    .intro-card {
        padding: 16px;
    }

    .intro-head {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
}
</style>
